# Native — only the TOP-LEVEL android/ and ios/ are generated by prebuild.
# The leading slash anchors these patterns to the project root, so
# modules/habit-widget-bridge/android/ stays tracked.
/android/
/ios/

# Env / secrets
.env
.env.*
!.env.example

# EAS
.easignore
